# Paths to the data folder (the graders swap this folder for their own copy)
POLICIES_PATH=./data/policies.md
MANIFEST_PATH=./data/manifest.json
DB_PATH=./data/shopsphere.db

# The date the service treats as "today" (never the system clock)
APP_TODAY=2026-07-01

# LLM provider: groq (default) | mock
# "mock" needs no API key: a deterministic rule-based stand-in used for local testing.
LLM_PROVIDER=groq
# Groq model (default llama-3.3-70b-versatile). Other good tool-calling options:
# llama-3.1-8b-instant (faster), openai/gpt-oss-120b, moonshotai/kimi-k2-instruct
LLM_MODEL=llama-3.3-70b-versatile
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1

# Maximum tool calls per message before the assistant stops and replies politely
MAX_TOOL_CALLS=6
